+void h8_device::kpdev_trace_open()
+{
+	m_kpdev_trace_init = true;
+	if (std::string_view(tag()) != ":subcpu")
+		return;
+	if (const char *ct = std::getenv("KPDEV_H8_CALLTRACE"))
+	{
+		std::string spec(ct);
+		const auto colon = spec.rfind(':');
+		if (colon != std::string::npos && colon > 1)
+		{
+			m_kpdev_callpc.assign(0x80000, 0);
+			const char *p = spec.c_str() + colon + 1;
+			while (*p)
+			{
+				char *end = nullptr;
+				const unsigned long pc = std::strtoul(p, &end, 16);
+				if (end == p)
+					break;
+				if (pc < 0x100000)
+					m_kpdev_callpc[pc >> 1] = 1;
+				p = (*end == ',') ? end + 1 : end;
+			}
+			m_kpdev_calltrace = std::fopen(spec.substr(0, colon).c_str(), "wb");
+			if (m_kpdev_calltrace)
+				std::setvbuf(m_kpdev_calltrace, nullptr, _IOFBF, 1 << 22);
+		}
+	}
+	if (const char *rd = std::getenv("KPDEV_H8_RAMDUMP"))
+	{
+		std::string spec(rd);
+		const auto colon = spec.rfind(':');
+		if (colon != std::string::npos && colon > 1)
+		{
+			m_kpdev_ramdump_prefix = spec.substr(0, colon);
+			const char *p = spec.c_str() + colon + 1;
+			while (*p)
+			{
+				char *end = nullptr;
+				const double s = std::strtod(p, &end);
+				if (end == p)
+					break;
+				m_kpdev_ramdump_cycles.push_back(u64(s * clock()));
+				p = (*end == ',') ? end + 1 : end;
+			}
+			std::sort(m_kpdev_ramdump_cycles.rbegin(), m_kpdev_ramdump_cycles.rend());   // pop from back
+		}
+	}
+	const char *env = std::getenv("KPDEV_H8_PCTRACE");
+	if (!env)
+		return;
+	std::string spec(env);
+	const auto c2 = spec.rfind(':');
+	const auto c1 = c2 == std::string::npos ? c2 : spec.rfind(':', c2 - 1);
+	if (c1 == std::string::npos)
+		return;
+	const double start = std::strtod(spec.c_str() + c1 + 1, nullptr);
+	const double end = std::strtod(spec.c_str() + c2 + 1, nullptr);
+	m_kpdev_trace_start = u64(start * clock());
+	m_kpdev_trace_end = u64(end * clock());
+	m_kpdev_trace = std::fopen(spec.substr(0, c1).c_str(), "wb");
+	if (m_kpdev_trace)
+		std::setvbuf(m_kpdev_trace, nullptr, _IOFBF, 1 << 22);
+}
+
+void h8_device::kpdev_ramdump(u64 cycle)
+{
+	m_kpdev_ramdump_cycles.pop_back();
+	const std::string path = m_kpdev_ramdump_prefix + "_" + std::to_string(cycle / 256) + ".bin";
+	if (std::FILE *f = std::fopen(path.c_str(), "wb"))
+	{
+		address_space &sp = space(AS_PROGRAM);
+		for (offs_t a = 0x40000; a < 0x60000; a++) std::fputc(sp.read_byte(a), f);
+		for (offs_t a = 0xffd10; a < 0xfff10; a++) std::fputc(sp.read_byte(a), f);
+		const u32 regs[3] = { u32(cycle), u32(cycle >> 32), m_NPC };
+		std::fwrite(regs, sizeof(regs), 1, f);
+		std::fclose(f);
+	}
+}
+
 void h8_device::execute_run()
 {
+	if (!m_kpdev_trace_init)
+		kpdev_trace_open();
 	internal_update(total_cycles());
 
 	m_icount -= m_count_before_instruction_step;
@@ -366,6 +448,26 @@ void h8_device::execute_run()
 				m_PPC = m_NPC;
 				if(debugger_enabled())
 					debugger_instruction_hook(m_NPC);
+				if(!m_kpdev_ramdump_cycles.empty() && total_cycles() >= m_kpdev_ramdump_cycles.back())
+					kpdev_ramdump(total_cycles());
+				if(m_kpdev_calltrace && m_NPC < 0x100000 && m_kpdev_callpc[m_NPC >> 1]) {
+					u32 rec[10];
+					rec[0] = m_NPC;
+					rec[1] = u32(total_cycles());
+					for(int r = 0; r < 8; r++)
+						rec[2 + r] = (u32(m_R[r + 8]) << 16) | m_R[r];
+					std::fwrite(rec, sizeof(rec), 1, m_kpdev_calltrace);
+				}
+				if(m_kpdev_trace) {
+					const u64 c = total_cycles();
+					if(c >= m_kpdev_trace_end) {
+						std::fclose(m_kpdev_trace);
+						m_kpdev_trace = nullptr;
+					} else if(c >= m_kpdev_trace_start) {
+						const u32 rec[2] = { m_NPC, u32(c) };
+						std::fwrite(rec, sizeof(rec), 1, m_kpdev_trace);
+					}
+				}
 			}
 			do_exec_full();
 		}
