+void tms57002_device::host_trace(char kind, unsigned index, u32 value)
+{
+	if (!m_host_trace)
+		return;
+	const attotime now = machine().time();
+	std::fprintf(m_host_trace, "%c,%u,%08X,%llu,%.9f\n", kind, index, value,
+		(unsigned long long)now.as_ticks(48000), now.as_double());
+}
+
+void tms57002_device::replay_rec(u8 kind, u8 a, const u32 *v)
+{
+	if (!m_replay_trace)
+		return;
+	u32 rec[11] = {};
+	rec[0] = u32(kind) | (u32(a) << 8);
+	rec[1] = u32(m_sound_updates);
+	rec[2] = m_trace_steps;
+	if (v)
+		for (int i = 0; i < 8; i++)
+			rec[3 + i] = v[i];
+	std::fwrite(rec, sizeof(rec), 1, m_replay_trace);
+}
+
+void tms57002_device::device_stop()
+{
+	if (m_host_trace)
+	{
+		std::fclose(m_host_trace);
+		m_host_trace = nullptr;
+	}
+	if (m_replay_trace)
+	{
+		std::fclose(m_replay_trace);
+		m_replay_trace = nullptr;
+	}
+}
